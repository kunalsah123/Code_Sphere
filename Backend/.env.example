NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/codemaster?retryWrites=true&w=majority
REDIS_URL=rediss://default:<password>@<redis-host>:<port>
JWT_SECRET=generate-a-random-secret-with-at-least-32-bytes
